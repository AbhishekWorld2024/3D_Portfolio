# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values. NEVER commit the real .env.
#
# Defaults below run the chatbot 100% locally and free via Ollama — no API key.
# Prerequisite: `ollama pull nomic-embed-text && ollama pull llama3.2:1b`.
# ---------------------------------------------------------------------------

# --- Embeddings ---
# "ollama" (default; free, local), "openai" (small cost), or
# "huggingface" (free, local, needs torch).
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM (chat) ---
# LLM_PROVIDER: "ollama" (default) or "openai" (incl. OpenAI-compatible APIs).
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:1b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=220

# --- Ollama (used when EMBEDDING_PROVIDER=ollama or LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Faster / cloud LLM (optional) ---
# For ~1-2s responses, use Groq (free, OpenAI-compatible). Set LLM_PROVIDER=openai
# and uncomment these:
# OPENAI_API_KEY=gsk_your-groq-key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Retrieval ---
RETRIEVER_K=4
RETRIEVER_SEARCH_TYPE=mmr              # "similarity" or "mmr"

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# --- Storage ---
COLLECTION_NAME=abhishek_portfolio
# DATA_DIR=./data
# CHROMA_DIR=./chroma_db

# --- API CORS ---
# Comma-separated allowed origins, or "*" for any (dev only).
# Example: https://your-portfolio.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=*
