# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- LLM / embeddings credentials ---
# Required when EMBEDDING_PROVIDER=openai and/or the LLM uses OpenAI.
OPENAI_API_KEY=sk-your-key-here

# Optional: point the OpenAI-compatible client at another provider.
# Example (Groq): https://api.groq.com/openai/v1
# OPENAI_BASE_URL=

# --- Embeddings ---
# "openai" (text-embedding-3-small, small cost),
# "huggingface" (free, local, needs torch), or
# "ollama" (free, fully local via a running Ollama server).
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- LLM (chat) ---
# LLM_PROVIDER: "openai" (or OpenAI-compatible via OPENAI_BASE_URL) or "ollama".
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# --- Ollama (used when EMBEDDING_PROVIDER=ollama or LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Retrieval ---
RETRIEVER_K=6
RETRIEVER_SEARCH_TYPE=mmr              # "similarity" or "mmr"

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# --- Storage ---
COLLECTION_NAME=abhishek_portfolio
# DATA_DIR=./data
# CHROMA_DIR=./chroma_db

# --- API CORS ---
# Comma-separated allowed origins, or "*" for any (dev only).
# Example: https://your-portfolio.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=*
